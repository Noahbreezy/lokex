# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=lokex

# Scanner Token (required)
TOKEN=your_scanner_bot_token_here
SCANNER_TEST_TOKEN=your_scanner_bot_token_here
LOK_WS_TOKEN=your_websocket_token_here

# XOR Encryption (optional - get from game API regionHash)
XOR_PASS=your_xor_encryption_password

# Discord Bot Integration (optional - set for Discord alerts)
DISCORD_TOKEN=your_discord_bot_token_here

# Scanner Debug Settings (optional - for troubleshooting)
SCANNER_DEBUG=false
DEBUG_SCANNER=false

# Batch Processing Timings (optional - tune for rate limiting)
SCANNER_BATCH_DELAY_MS=25
SCANNER_BATCH_TIMEOUT_MS=3000

# Proxy Configuration (optional)
SCANNER_USE_PROXIES=true
SCANNER_RANK_PROXIES=false
SCANNER_RANK_PROXY_COUNT=25
SCANNER_RANK_PROXY_TIMEOUT_MS=20000
SCANNER_RANK_PROXY_CONCURRENCY=5

# API URLs (optional - defaults are provided)
LOK_API_URL=https://api-lok-live.leagueofkingdoms.com
LOK_WS_BASE=wss://socf-lok-live.leagueofkingdoms.com/socket.io/?EIO=4&transport=websocket
PAYMENT_ADDRESS=
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/your_infura_key

# GitHub Token (optional - for updates/repo access)
GITHUB_TOKEN=ghp_your_github_token_here

# Placeholder (optional)
PLACEHOLDER=your_placeholder_value
